# Nusxa oling: cp .env.example .env — va CHANGE_ME qiymatlarini almashtiring.
# Bu fayl ham docker compose, ham lokal uvicorn uchun ishlatiladi.

# dev | prod (prodda /docs yopiladi)
APP_ENV=dev
LOG_LEVEL=INFO
# Lokal ishlashda o'qish oson bo'lishi uchun false qiling
LOG_JSON=true

# --- Portlar (faqat 127.0.0.1 da ochiladi) ---
# Serverda band: 8000, 8010, 3001, 8080, 9000-9001, 9010, 5434, 5435, 5440, 6385
API_HOST_PORT=8020
DB_HOST_PORT=5442

# --- Postgres ---
POSTGRES_DB=chocolate
POSTGRES_USER=chocolate
# Yaratish: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=CHANGE_ME

# Docker'siz (lokal uvicorn, alembic, scripts) ishlaganda ishlatiladi.
# Parol POSTGRES_PASSWORD bilan bir xil bo'lsin. Compose ichida bu qiymat
# avtomatik ravishda @db:5432 ga almashtiriladi.
DATABASE_URL=postgresql+psycopg://chocolate:CHANGE_ME@localhost:5442/chocolate

# Kamida 32 belgi. Yaratish: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME

ACCESS_TOKEN_EXPIRE_MINUTES=720
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=5

# Frontend manzillari, vergul bilan
CORS_ORIGINS=http://localhost:5173

TIMEZONE=Asia/Tashkent